{
  "name": "@ts-grm/sql",
  "main": "index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ts-grm/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup --dts",
    "dev": "tsup --watch --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui --coverage",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "vitest typecheck tests/**/*.test-d.ts --ui",
    "type-check": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepublishOnly": "yarn build && yarn test && yarn type-check"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/mssql": "^12.3.0",
    "@types/oracledb": "^7.0.2",
    "@types/pg": "^8.20.0",
    "better-sqlite3": "^13.0.3",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.2",
    "oracledb": "^7.0.1",
    "pg": "^8.23.0"
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "mssql": "*",
    "mysql2": "*",
    "oracledb": "*",
    "pg": "*"
  }
}
