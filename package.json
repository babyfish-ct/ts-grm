{
  "name": "ts-grm",
  "private": true,
  "packageManager": "yarn@4.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -A run build",
    "dev": "yarn workspaces foreach -p -i run dev",
    "test": "yarn workspaces foreach -A run test",
    "lint": "yarn workspaces foreach -A run lint",
    "clean": "yarn workspaces foreach -A run clean",
    "test:watch": "yarn workspaces foreach -p -i run test:watch",
    "test:ui": "yarn workspaces foreach -A -p -i run test:ui",
    "test:ui:core": "yarn workspace @ts-grm/core run test:ui",
    "test:ui:sql": "yarn workspace @ts-grm/sql run test:ui",
    "test:ui:sqlall": "TEST_TARGET=external yarn workspace @ts-grm/sql run test:ui",
    "test:coverage": "yarn workspaces foreach -A run test:coverage",
    "test:typecheck": "yarn workspaces foreach -A run test:typecheck",
    "publish": "yarn build && yarn test && yarn workspaces foreach -A --no-private --topological npm publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "4.0.16",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "4.0.16"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "p-memoize": "^8.0.0"
  }
}
